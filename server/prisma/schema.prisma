
generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// TABLE 1: users

model User {
  id           String   @id @default(uuid())   // UUID primary key (better than integer for security)
  name         String
  email        String   @unique                // No two users can have same email
  phone        String?                         // Optional (? means nullable)
  passwordHash String                          // NEVER store plain password — always hashed
  role         Role     @default(CUSTOMER)     // Default role is CUSTOMER when someone registers
  refreshToken String?                         // We store hashed refresh token here for security
  createdAt    DateTime @default(now())        // Auto-set to current time on create
  updatedAt    DateTime @updatedAt             // Auto-update whenever record changes

  // Relations — these don't create DB columns, they tell Prisma how tables connect
  facilities   Facility[]   // One owner can have many facilities
  bookings     Booking[]    // One customer can have many bookings
  waitlist     Waitlist[]   // One user can be on many waitlists

  @@map("users")   // Actual table name in PostgreSQL will be "users" (lowercase)
}


// TABLE 2: facilities

model Facility {
  id          String   @id @default(uuid())
  ownerId     String                         // FK
  name        String
  description String?
  address     String
  city        String
  latitude    Float                            
  longitude   Float                            
  imageUrl    String?                          
  imageUrls   String[]  @default([]) 
  isActive    Boolean  @default(true)          
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  courts      Court[] 

  @@map("facilities")
}


// TABLE 3: courts
model Court {
  id          String   @id @default(uuid())
  facilityId  String
  name        String                           
  sportType   String                           
  description String?
  basePrice   Decimal  @db.Decimal(10, 2)     
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  facility    Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  slots       Slot[]   

  @@map("courts")
}


// TABLE 4: slots
model Slot {
  id        String     @id @default(uuid())
  courtId   String
  startTime DateTime                           
  endTime   DateTime                           
  price     Decimal    @db.Decimal(10, 2)     
  status    SlotStatus @default(AVAILABLE)     
  createdAt DateTime   @default(now())

  court     Court      @relation(fields: [courtId], references: [id], onDelete: Cascade)
  booking   Booking?   
  waitlist  Waitlist[]

  @@map("slots")
}


// TABLE 5: bookings

model Booking {
  id          String        @id @default(uuid())
  slotId      String        @unique             
  userId      String
  status      BookingStatus @default(PENDING)   
  totalAmount Decimal       @db.Decimal(10, 2)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  slot        Slot          @relation(fields: [slotId], references: [id])
  user        User          @relation(fields: [userId], references: [id])
  payment     Payment?      

  @@map("bookings")
}


// TABLE 6: payments

model Payment {
  id                String        @id @default(uuid())
  bookingId         String        @unique            
  razorpayOrderId   String        @unique            
  razorpayPaymentId String?                          
  razorpaySignature String?                         
  amount            Decimal       @db.Decimal(10, 2)
  status            PaymentStatus @default(CREATED)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  booking           Booking       @relation(fields: [bookingId], references: [id])

  @@map("payments")
}


// TABLE 7: waitlist

model Waitlist {
  id        String   @id @default(uuid())
  slotId    String
  userId    String
  position  Int                              
  createdAt DateTime @default(now())

  slot      Slot     @relation(fields: [slotId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

 
  @@unique([slotId, userId])
  @@map("waitlist")
}


// ENUMS —

enum Role {
  OWNER      
  CUSTOMER   
}

enum SlotStatus {
  AVAILABLE  
  LOCKED  
  BOOKED     
  CANCELLED   
}

enum BookingStatus {
  PENDING     
  CONFIRMED
  CANCELLED   
}

enum PaymentStatus {
  CREATED    
  PAID       
  FAILED     
  REFUNDED   
}
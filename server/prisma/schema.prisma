// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

// This tells Prisma to generate JavaScript client code you can use in your app
generator client {
  provider = "prisma-client-js"
}

// This tells Prisma which database to connect to
// The DATABASE_URL value comes from your .env file
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// TABLE 1: users
// Stores both owners and customers — role field separates them
// ============================================================
model User {
  id           String   @id @default(uuid())   // UUID primary key (better than integer for security)
  name         String
  email        String   @unique                // No two users can have same email
  phone        String?                         // Optional (? means nullable)
  passwordHash String                          // NEVER store plain password — always hashed
  role         Role     @default(CUSTOMER)     // Default role is CUSTOMER when someone registers
  refreshToken String?                         // We store hashed refresh token here for security
  createdAt    DateTime @default(now())        // Auto-set to current time on create
  updatedAt    DateTime @updatedAt             // Auto-update whenever record changes

  // Relations — these don't create DB columns, they tell Prisma how tables connect
  facilities   Facility[]   // One owner can have many facilities
  bookings     Booking[]    // One customer can have many bookings
  waitlist     Waitlist[]   // One user can be on many waitlists

  @@map("users")   // Actual table name in PostgreSQL will be "users" (lowercase)
}

// ============================================================
// TABLE 2: facilities
// A facility is the turf complex (can have multiple courts inside)
// ============================================================
model Facility {
  id          String   @id @default(uuid())
  ownerId     String                           // Foreign key — links to users table
  name        String
  description String?
  address     String
  city        String
  latitude    Float                            // For geolocation search (e.g. 19.0760)
  longitude   Float                            // For geolocation search (e.g. 72.8777)
  imageUrl    String?                          // Cloudinary URL (added in Day 4)
  isActive    Boolean  @default(true)          // Owner can deactivate facility
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // This creates the actual foreign key constraint in PostgreSQL
  // onDelete: Cascade means if owner is deleted, their facilities are also deleted
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  courts      Court[]  // One facility has many courts

  @@map("facilities")
}

// ============================================================
// TABLE 3: courts
// A court is inside a facility (e.g. "Court A", "Court B")
// ============================================================
model Court {
  id          String   @id @default(uuid())
  facilityId  String
  name        String                           // e.g. "Court A", "Main Ground"
  sportType   String                           // e.g. "Football", "Badminton", "Cricket"
  description String?
  basePrice   Decimal  @db.Decimal(10, 2)     // e.g. 500.00 — Decimal is for money (never use Float for money)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  facility    Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  slots       Slot[]   // One court has many time slots

  @@map("courts")
}

// ============================================================
// TABLE 4: slots
// A slot is a specific time block on a court (e.g. 6PM-7PM on Court A)
// This is what customers actually book
// ============================================================
model Slot {
  id        String     @id @default(uuid())
  courtId   String
  startTime DateTime                           // e.g. 2025-07-14 18:00:00
  endTime   DateTime                           // e.g. 2025-07-14 19:00:00
  price     Decimal    @db.Decimal(10, 2)     // Can differ from court basePrice (dynamic pricing later)
  status    SlotStatus @default(AVAILABLE)     // AVAILABLE → BOOKED when someone books it
  createdAt DateTime   @default(now())

  court     Court      @relation(fields: [courtId], references: [id], onDelete: Cascade)
  booking   Booking?   // ? means a slot might not have a booking yet (it's available)
  waitlist  Waitlist[]

  @@map("slots")
}

// ============================================================
// TABLE 5: bookings
// Created when a customer books a slot
// Status is PENDING until payment is confirmed
// ============================================================
model Booking {
  id          String        @id @default(uuid())
  slotId      String        @unique             // @unique means one slot = one booking (prevents double booking at DB level)
  userId      String
  status      BookingStatus @default(PENDING)   // Starts PENDING, moves to CONFIRMED after payment
  totalAmount Decimal       @db.Decimal(10, 2)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  slot        Slot          @relation(fields: [slotId], references: [id])
  user        User          @relation(fields: [userId], references: [id])
  payment     Payment?      // ? because payment record is created separately

  @@map("bookings")
}

// ============================================================
// TABLE 6: payments
// Stores Razorpay payment details linked to a booking
// ============================================================
model Payment {
  id                String        @id @default(uuid())
  bookingId         String        @unique            // One payment per booking
  razorpayOrderId   String        @unique            // Created when booking is initiated
  razorpayPaymentId String?                          // Set after customer pays (nullable until then)
  razorpaySignature String?                          // For signature verification
  amount            Decimal       @db.Decimal(10, 2)
  status            PaymentStatus @default(CREATED)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  booking           Booking       @relation(fields: [bookingId], references: [id])

  @@map("payments")
}

// ============================================================
// TABLE 7: waitlist
// When a slot is booked, other customers can join a waitlist
// If booking is cancelled, waitlist[0] gets notified first
// ============================================================
model Waitlist {
  id        String   @id @default(uuid())
  slotId    String
  userId    String
  position  Int                              // 1 = first in line, 2 = second, etc.
  createdAt DateTime @default(now())

  slot      Slot     @relation(fields: [slotId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A user can only be on the waitlist ONCE per slot
  @@unique([slotId, userId])
  @@map("waitlist")
}

// ============================================================
// ENUMS — fixed set of allowed values (like constants)
// ============================================================

enum Role {
  OWNER      // Turf facility owner
  CUSTOMER   // Person booking the turf
}

enum SlotStatus {
  AVAILABLE   // Can be booked
  LOCKED  
  BOOKED      // Already taken
  CANCELLED   // Was booked but got cancelled (now available again)
}

enum BookingStatus {
  PENDING     // Customer clicked "Book" but hasn't paid yet
  CONFIRMED   // Payment done, booking is confirmed
  CANCELLED   // Cancelled by customer or system
}

enum PaymentStatus {
  CREATED    // Razorpay order created, waiting for payment
  PAID       // Payment successful
  FAILED     // Payment failed
  REFUNDED   // Money sent back to customer
}